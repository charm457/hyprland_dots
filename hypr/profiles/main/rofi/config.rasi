configuration {
    modi: "drun,run,filebrowser";
    show-icons: true;
    font: "JetBrainsMono Nerd Font 12";
    display-drun: "Apps";
    display-run: "Run";
    display-filebrowser: "Files";
    drun-display-format: "{name}";
    steal-focus: true;
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: [ MousePrimary ];
    sorting-method: "fzf";
}

@theme "style"
